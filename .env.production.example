# Entorno del build de produccion. Copiar a `.env.production` (no se versiona)
# y rellenar antes de ejecutar ./scripts/build-deploy.sh
#
# Estas variables se usan en DOS momentos distintos:
#
#   - build (esta maquina): NEXT_PUBLIC_SERVER_URL se incrusta en el bundle del
#     navegador y ya no se puede cambiar sin recompilar. DATABASE_URL se usa
#     para prerenderizar paginas, asi que el build ya habla con la base real.
#   - runtime (servidor): las mismas variables, menos las NEXT_PUBLIC_, se leen
#     del `.env` que se crea a mano en el servidor. Ver DEPLOY.md.

# Postgres externo (Neon / Supabase). Con Neon: usar la cadena "pooled" y
# conservar ?sslmode=require
DATABASE_URL=postgresql://usuario:password@ep-xxxx.neon.tech/tropicalrealty?sslmode=require

# openssl rand -hex 32   — cambiarla invalida todas las sesiones del admin
PAYLOAD_SECRET=

# Dominio publico, sin barra final
NEXT_PUBLIC_SERVER_URL=https://tropicalrealty.com

# openssl rand -hex 32
CRON_SECRET=
PREVIEW_SECRET=
