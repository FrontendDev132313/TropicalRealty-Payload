# Variables del contenedor de GoDaddy.
#
# NO es un fichero que se suba: es la lista de lo que hay que dar de alta en el
# panel, una por una. En el editor del panel, el nombre va en el campo *nombre*
# y el valor en el campo *valor* — pegar la linea entera en el campo del valor
# deja la clave dentro del valor y el arranque falla con `Invalid URL`.

# --- Obligatorias ------------------------------------------------------------

# Activa el modo produccion en scripts/start.mjs (migraciones + build + start).
# Sin esta variable el contenedor arrancaria `next dev`, que no sirve para
# produccion.
DEPLOY_TARGET=container

# Supabase, cadena del *Session pooler* (Dashboard > Connect > Session pooler).
# Puerto 5432, no 6543: el modo transaction no soporta prepared statements y
# Payload los usa via drizzle. La conexion directa `db.<ref>.supabase.co` no
# sirve: solo resuelve por IPv6.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# openssl rand -hex 32 — cambiarla invalida todas las sesiones del admin
PAYLOAD_SECRET=

# Dominio publico, sin barra final. Se incrusta en el bundle del navegador
# durante el build: si cambia, hay que reconstruir (basta con reiniciar el
# contenedor sin REUSE_BUILD).
NEXT_PUBLIC_SERVER_URL=https://tropicalrealty.com.mx

# openssl rand -hex 32
CRON_SECRET=
PREVIEW_SECRET=

# --- Uploads: Supabase Storage ----------------------------------------------
# El disco del contenedor es efimero. Con S3_BUCKET definido, Payload deja de
# escribir en el sistema de ficheros y sube a Supabase Storage, que habla el
# protocolo de S3. Las claves se generan en Dashboard > Storage > S3 Access Keys
# (no son la anon key ni la service_role key).

S3_BUCKET=media
S3_REGION=<la region del proyecto, p.ej. us-east-1>
S3_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Opcionales --------------------------------------------------------------

# Reutiliza el build existente en vez de recompilar en cada reinicio del
# contenedor. Deja de ponerla (o ponla a 0) cuando despliegues codigo nuevo o
# cambies NEXT_PUBLIC_SERVER_URL.
# REUSE_BUILD=1

# Omite las migraciones al arrancar.
# SKIP_MIGRATE=1

# Si `next build` se queda sin memoria en el contenedor.
# NODE_OPTIONS=--max-old-space-size=2048
